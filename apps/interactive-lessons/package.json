{
  "name": "study-ai-interactive-lessons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:architectures": "node scripts/generate-architectures.mjs",
    "prebuild": "node scripts/generate-architectures.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "prebuild:dist": "node scripts/generate-architectures.mjs",
    "build:dist": "tsc -p tsconfig.json && vite build --outDir dist",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "pretest": "node scripts/generate-architectures.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "vitest": "^4.1.8"
  }
}
